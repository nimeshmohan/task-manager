rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /boards/{boardId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid == resource.data.ownerId ||
         // Allow self-join: only change is adding self to memberIds
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.auth.uid in request.resource.data.memberIds));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    match /columns/{columnId} {
      allow read, write: if request.auth != null;
    }
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
  }
}
